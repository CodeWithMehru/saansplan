# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Python files
*.py text eol=lf diff=python
*.pyi text eol=lf diff=python

# Web assets
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf

# Configurations
Makefile text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
