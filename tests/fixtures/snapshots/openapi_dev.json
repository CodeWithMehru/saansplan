{
  "components": {
    "schemas": {
      "Activity": {
        "additionalProperties": false,
        "description": "Structured discrete schedule block for family routine exposure tracking.",
        "properties": {
          "duration_min": {
            "maximum": 720.0,
            "minimum": 1.0,
            "title": "Duration Min",
            "type": "integer"
          },
          "intensity": {
            "$ref": "#/components/schemas/Intensity"
          },
          "label": {
            "maxLength": 60,
            "title": "Label",
            "type": "string"
          },
          "member_refs": {
            "items": {
              "type": "integer"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Member Refs",
            "type": "array"
          },
          "mode": {
            "$ref": "#/components/schemas/TravelMode"
          },
          "place": {
            "$ref": "#/components/schemas/ActivityPlace"
          },
          "start_hour": {
            "maximum": 23.0,
            "minimum": 0.0,
            "title": "Start Hour",
            "type": "integer"
          }
        },
        "required": [
          "label",
          "start_hour",
          "duration_min",
          "place",
          "mode",
          "intensity",
          "member_refs"
        ],
        "title": "Activity",
        "type": "object"
      },
      "ActivityPlace": {
        "description": "Micro-environment category where an activity takes place.",
        "enum": [
          "outdoor",
          "indoor",
          "vehicle"
        ],
        "title": "ActivityPlace",
        "type": "string"
      },
      "AgeGroup": {
        "description": "Vulnerability age bracket for breathing rate scaling and AQI susceptibility.",
        "enum": [
          "child",
          "adult",
          "elderly"
        ],
        "title": "AgeGroup",
        "type": "string"
      },
      "AskRequest": {
        "additionalProperties": false,
        "description": "Payload for submitting an air quality question with location coordinates.",
        "properties": {
          "city": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": "Delhi",
            "title": "City"
          },
          "latitude": {
            "anyOf": [
              {
                "maximum": 90.0,
                "minimum": -90.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 28.6139,
            "title": "Latitude"
          },
          "longitude": {
            "anyOf": [
              {
                "maximum": 180.0,
                "minimum": -180.0,
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "default": 77.209,
            "title": "Longitude"
          },
          "question": {
            "maxLength": 300,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskRequest",
        "type": "object"
      },
      "FamilyMember": {
        "additionalProperties": false,
        "description": "Individual family member profile with physiological sensitivity.",
        "properties": {
          "age_group": {
            "$ref": "#/components/schemas/AgeGroup"
          },
          "name": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "sensitive": {
            "default": false,
            "title": "Sensitive",
            "type": "boolean"
          }
        },
        "required": [
          "age_group"
        ],
        "title": "FamilyMember",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HomeSetup": {
        "additionalProperties": false,
        "description": "Residential baseline factors dictating indoor infiltration and emission sources.",
        "properties": {
          "cooking": {
            "enum": [
              "lpg",
              "induction",
              "wood_coal",
              "other"
            ],
            "title": "Cooking",
            "type": "string"
          },
          "has_chimney": {
            "title": "Has Chimney",
            "type": "boolean"
          },
          "heating": {
            "enum": [
              "none",
              "electric",
              "wood_coal",
              "gas",
              "other"
            ],
            "title": "Heating",
            "type": "string"
          },
          "purifier": {
            "title": "Purifier",
            "type": "boolean"
          },
          "windows": {
            "enum": [
              "mostly_open",
              "mostly_closed"
            ],
            "title": "Windows",
            "type": "string"
          }
        },
        "required": [
          "heating",
          "cooking",
          "windows",
          "purifier",
          "has_chimney"
        ],
        "title": "HomeSetup",
        "type": "object"
      },
      "Intensity": {
        "description": "Physical exertion intensity affecting minute ventilation rate.",
        "enum": [
          "rest",
          "light",
          "moderate",
          "heavy"
        ],
        "title": "Intensity",
        "type": "string"
      },
      "PlanRequest": {
        "additionalProperties": false,
        "description": "Payload for submitting location, family demographics, and optional routine.",
        "properties": {
          "city": {
            "anyOf": [
              {
                "maxLength": 80,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "City"
          },
          "language": {
            "default": "hinglish",
            "enum": [
              "en",
              "hinglish",
              "hi"
            ],
            "title": "Language",
            "type": "string"
          },
          "latitude": {
            "maximum": 90.0,
            "minimum": -90.0,
            "title": "Latitude",
            "type": "number"
          },
          "longitude": {
            "maximum": 180.0,
            "minimum": -180.0,
            "title": "Longitude",
            "type": "number"
          },
          "members": {
            "items": {
              "$ref": "#/components/schemas/FamilyMember"
            },
            "maxItems": 12,
            "minItems": 1,
            "title": "Members",
            "type": "array"
          },
          "routine": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Routine"
              },
              {
                "type": "null"
              }
            ]
          },
          "routine_text": {
            "default": "",
            "maxLength": 1000,
            "title": "Routine Text",
            "type": "string"
          }
        },
        "required": [
          "latitude",
          "longitude",
          "members"
        ],
        "title": "PlanRequest",
        "type": "object"
      },
      "Routine": {
        "additionalProperties": false,
        "description": "Full family daily schedule and residential characteristics.",
        "properties": {
          "activities": {
            "items": {
              "$ref": "#/components/schemas/Activity"
            },
            "maxItems": 24,
            "title": "Activities",
            "type": "array"
          },
          "home": {
            "$ref": "#/components/schemas/HomeSetup"
          },
          "unclear": {
            "items": {
              "type": "string"
            },
            "maxItems": 12,
            "title": "Unclear",
            "type": "array"
          }
        },
        "required": [
          "activities",
          "home"
        ],
        "title": "Routine",
        "type": "object"
      },
      "TravelMode": {
        "description": "Transportation modality used during transit activities.",
        "enum": [
          "walk",
          "cycle",
          "bike",
          "car",
          "bus",
          "metro",
          "none"
        ],
        "title": "TravelMode",
        "type": "string"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "SaansPlan",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/": {
      "get": {
        "description": "Serve the lightweight application shell.",
        "operationId": "index__get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Index"
      }
    },
    "/api/ask": {
      "post": {
        "description": "Provide grounded answers using server-side engine facts, KB entries, and Groq.",
        "operationId": "ask_api_ask_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AskRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Ask Api Ask Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Ask",
        "tags": [
          "ask"
        ]
      }
    },
    "/api/geocode": {
      "get": {
        "description": "Search a city and return only safe display coordinates.",
        "operationId": "geocode_api_geocode_get",
        "parameters": [
          {
            "in": "query",
            "name": "name",
            "required": true,
            "schema": {
              "maxLength": 80,
              "minLength": 2,
              "title": "Name",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Geocode Api Geocode Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Geocode",
        "tags": [
          "geocode"
        ]
      }
    },
    "/api/health": {
      "get": {
        "description": "Return a no-dependency liveness response.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/plan": {
      "post": {
        "description": "Fetch AQ, parse routine, run physical engines, and return full suite of recommendations.",
        "operationId": "create_plan_api_plan_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PlanRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Create Plan Api Plan Post",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Create Plan",
        "tags": [
          "plan"
        ]
      }
    },
    "/favicon.ico": {
      "get": {
        "description": "Serve a tiny inline SVG favicon.",
        "operationId": "favicon_favicon_ico_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {}
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Favicon"
      }
    },
    "/health": {
      "get": {
        "description": "Return a no-dependency liveness response.",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    }
  }
}